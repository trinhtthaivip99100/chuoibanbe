@model List<KetBanChoiChuoi.Models.Friendship>
@{ ViewData["Title"] = "Thông Báo Lời Mời"; }
<div class="glass-card" style="max-width: 600px; margin: 0 auto;">
    <h2 class="text-center mb-4">Lời Mời Kết Bạn</h2>
    
    @if(Model == null || Model.Count == 0) {
        <p class="text-center text-gray">Bạn không có lời mời nào mới.</p>
    } else {
        <input type="text" id="filterRequests" placeholder="Tìm tên hoặc ID..." style="box-sizing: border-box; width: 100%; padding: 0.8rem; border-radius: 8px; border: none; background: rgba(0,0,0,0.2); color: white; margin-bottom: 1rem; font-size: 0.9rem;" onkeyup="filterRequestList()" autocomplete="off" />

        <div id="requestListContainer" style="max-height: 250px; overflow-y: auto; padding-right: 0.5rem;">
            @foreach(var f in Model) {
                var sender = f.User1Id == f.ActionUserId ? f.User1 : f.User2;
                var senderAvatar = sender.AvatarUrl;
                <div class="request-item" data-name="@sender.DisplayName.ToLower()" data-id="@sender.Username.ToLower()" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 12px; margin-bottom: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 1rem; overflow: hidden;">
                        <div class="user-avatar" style="width: 50px; height: 50px; font-size: 1.2rem; flex-shrink: 0; margin: 0; overflow: hidden;">
                            @if(!string.IsNullOrEmpty(senderAvatar)) { <img src="@senderAvatar" style="width:100%; height:100%; object-fit:cover;" /> } 
                            else { @(sender.DisplayName.Substring(0,1).ToUpper()) }
                        </div>
                        <div style="overflow: hidden;">
                            <h3 style="margin:0; font-size: 1.1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@sender.DisplayName</h3>
                            <span class="text-gray" style="font-size: 0.85rem;">muốn chơi chuỗi với bạn</span>
                        </div>
                    </div>
                    <div style="display: flex; gap: 0.5rem; flex-shrink: 0;">
                        <form method="post" action="/Friend/Accept" style="margin: 0;">
                            <input type="hidden" name="id" value="@f.Id" />
                            <button type="submit" class="btn-glow" style="padding: 0.5rem 1rem; font-size: 0.9rem; border-radius: 20px; text-transform: none; letter-spacing: normal;">Chấp nhận</button>
                        </form>
                        <form method="post" action="/Friend/Decline" style="margin: 0;">
                            <input type="hidden" name="id" value="@f.Id" />
                            <button type="submit" class="btn-glow" style="padding: 0.5rem 1rem; font-size: 0.9rem; border-radius: 20px; text-transform: none; background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #ef4444; box-shadow: none;">Từ chối</button>
                        </form>
                    </div>
                </div>
            }
        </div>
        <div id="noRequestResult" style="display: none; text-align: center; color: gray; margin-top: 1rem; font-size: 0.9rem;">
            Không tìm thấy kết quả.
        </div>
    }
</div>

<style>
#requestListContainer::-webkit-scrollbar { width: 6px; }
#requestListContainer::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 10px; }
#requestListContainer::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
</style>

<script>
    function filterRequestList() {
        var input = document.getElementById('filterRequests').value.toLowerCase();
        var items = document.querySelectorAll('.request-item');
        var hasVisible = false;

        items.forEach(function(item) {
            var name = item.getAttribute('data-name');
            var id = item.getAttribute('data-id');
            if (name.includes(input) || id.includes(input)) {
                item.style.display = 'flex';
                hasVisible = true;
            } else {
                item.style.display = 'none';
            }
        });

        const noResult = document.getElementById('noRequestResult');
        if (noResult) {
            noResult.style.display = hasVisible ? 'none' : 'block';
        }
    }
</script>
