@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<div class="glass-card" style="max-width: 400px; margin: 2rem auto;">
    <h2 class="text-center mb-4" style="color: #38bdf8;">Đặt Lại Mật Khẩu</h2>
    <p class="text-center" style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 2rem;">Vui lòng nhập mã OTP vừa gửi tới <b>@ViewBag.Email</b> và Mật khẩu mới của bạn.</p>
    
    @if(ViewBag.Error != null) { <p style="color: #ef4444; text-align: center;">@ViewBag.Error</p> }
    
    <form method="post" action="/Auth/ResetPassword">
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <div class="mb-4">
            <input type="text" name="code" placeholder="Mã OTP 6 số" maxlength="6" style="box-sizing: border-box; width: 100%; padding: 1rem; border-radius: 12px; border: none; background: rgba(0,0,0,0.2); color: white; margin-bottom: 1rem; text-align: center; font-size: 1.2rem; letter-spacing: 3px; font-weight: bold;" required autocomplete="off" />
            <input type="password" name="newPassword" placeholder="Mật khẩu mới (Tối thiểu 6 ký tự)" minlength="6" style="box-sizing: border-box; width: 100%; padding: 1rem; border-radius: 12px; border: none; background: rgba(0,0,0,0.2); color: white;" required />
        </div>
        <button type="submit" class="btn-glow" style="width: 100%; background: #38bdf8; box-shadow: 0 0 15px rgba(56,189,248,0.3); color: #0f111a;">Lưu Mật Khẩu Mới</button>
    </form>
</div>
