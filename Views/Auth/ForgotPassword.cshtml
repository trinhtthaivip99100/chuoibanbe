@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="glass-card" style="max-width: 400px; margin: 2rem auto;">
    <h2 class="text-center mb-4">Quên Mật Khẩu</h2>
    <p class="text-center" style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 2rem;">Nhập Email bạn đã đăng ký để nhận mã khôi phục mật khẩu.</p>
    
    @if(ViewBag.Error != null) { <p style="color: #ef4444; text-align: center;">@ViewBag.Error</p> }
    
    <form method="post" action="/Auth/ForgotPassword">
        <div class="mb-4">
            <input type="email" name="email" placeholder="Địa chỉ Email" style="box-sizing: border-box; width: 100%; padding: 1rem; border-radius: 12px; border: none; background: rgba(0,0,0,0.2); color: white;" required />
        </div>
        <button type="submit" class="btn-glow" style="width: 100%; background: #38bdf8; box-shadow: 0 0 15px rgba(56,189,248,0.3);">Gửi Mã OTP</button>
    </form>
    <div style="text-align: center; margin-top: 1rem;">
        <a href="/Auth/Login" style="color: var(--text-secondary); text-decoration: none; font-size: 0.9rem;">Quay lại đăng nhập</a>
    </div>
</div>
